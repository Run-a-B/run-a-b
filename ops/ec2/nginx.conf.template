# Replace RUNAB_DOMAIN with the ONE approved canonical domain and its www alias.
# Install an existing certificate
# at the named paths first. This file never creates certificates or changes DNS.
# Include within nginx's http context. Run nginx -t before any reload.
server {
    listen 80;
    server_name RUNAB_DOMAIN www.RUNAB_DOMAIN;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/runab/acme;
        try_files $uri =404;
    }
    location / {
        return 308 https://RUNAB_DOMAIN$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name www.RUNAB_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/RUNAB_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RUNAB_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 308 https://RUNAB_DOMAIN$request_uri;
}

server {
    listen 443 ssl;
    server_name RUNAB_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/RUNAB_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RUNAB_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/runab/current/dist;
    index index.html;
    client_max_body_size 1m;

    # Preparation must not expose an application before a reviewed release exists.
    # A server-level return-only guard also covers /api/ and missing SPA assets.
    if (!-f /srv/runab/current/dist/index.html) { return 503; }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host RUNAB_DOMAIN;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host RUNAB_DOMAIN;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
        add_header Cache-Control "no-store" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    # Vite content-hashed assets only; missing assets must never fall back to HTML.
    location ~* "^/assets/.+-[a-z0-9_-]{8,}\.(js|css|woff2?|png|jpg|jpeg|gif|svg|webp|ico)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }

    location ~ /\. {
        deny all;
    }
}
