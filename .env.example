# Local MySQL started by compose.yaml (host port 3307 avoids a local MySQL on 3306).
DB_URL="jdbc:mysql://127.0.0.1:3307/runab_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
DB_USERNAME=root
DB_PASSWORD=mysql
SERVER_PORT=8082
VITE_API_BASE_URL=http://localhost:8082

# Local-only default. Replace this with a strong random secret outside development.
JWT_SECRET=runabLocalDevelopmentSecretKeyMustBeAtLeast32BytesLong

# Optional integrations. The application starts without these values, but the
# corresponding Google login, email verification, or AI features need real keys.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
MAIL_USERNAME=
MAIL_APP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 기업마당 OpenAPI key (required only for policy synchronization).
BIZINFO_API_KEY=

# Production: inject configuration via the service environment / secret manager.
# Set SPRING_PROFILES_ACTIVE=prod and provide DB_URL, DB_USERNAME, DB_PASSWORD,
# and a randomly generated JWT_SECRET (at least 32 bytes). Do not reuse the local
# defaults above. The prod profile validates the schema; apply migrations first.
# Production frontend builds use same-origin /api by default. Only set
# VITE_API_BASE_URL at build time when a separate API origin is intentional.
# Behind a reverse proxy, list ONLY its explicit source IPs. The proxy must append/replace client X-Forwarded-For.
# Leave empty for direct local access. Example for local Nginx: 127.0.0.1,::1
TRUSTED_PROXY_IPS=
SERVER_ADDRESS=127.0.0.1
